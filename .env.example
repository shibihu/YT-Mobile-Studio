# Copy this file to .env and fill in real values.
# Never commit .env or share its contents.

PORT=3000
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
GOOGLE_CLIENT_ID=REPLACE_WITH_REAL_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_REAL_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# Optional: dashboard auto-refresh interval in seconds (clamped to 30–3600). Default 60.
AUTO_REFRESH_SECONDS=60
